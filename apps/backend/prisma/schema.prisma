generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   Int                 @id @default(autoincrement())
  username             String              @unique
  email                String              @unique
  passwordHash         String
  role                 String
  createdAt            DateTime            @default(now())
  birthDate            DateTime
  urlImg               String
  signupIp             String?
  lastCopilotMessageAt DateTime?
  sessions             Session[]
  tablaturas           Tab[]
  tabViews             TabView[]
  copilotUsage         CopilotDailyUsage[]

  @@index([signupIp])
}

model Genre {
  id         Int    @id @default(autoincrement())
  name       String @unique
  tablaturas Tab[]
}

model Instrument {
  id         Int    @id @default(autoincrement())
  name       String @unique
  urlIco     String @default("")
  tablaturas Tab[]
}

model Tab {
  id           Int        @id @default(autoincrement())
  title        String     @unique
  artist       String     @default("")
  urlYoutube   String
  urlImagen    String
  urlPdf       String
  createdAt    DateTime   @default(now())
  userId       Int
  genreId      Int
  instrumentId Int
  viewCount    Int        @default(0)
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  genre        Genre      @relation(fields: [genreId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  views        TabView[]

  @@index([artist])
  @@index([genreId, createdAt])
  @@index([instrumentId, createdAt])
  @@index([viewCount])
}

model TabView {
  id       Int      @id @default(autoincrement())
  userId   Int
  tabId    Int
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tab      Tab      @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([tabId])
}

model CopilotDailyUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Session {
  tokenId   String   @id
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
